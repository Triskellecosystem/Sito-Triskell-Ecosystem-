# Copia in .env.local e compila. Non committare mai i valori reali.

# --- Form contatti (src/app/api/contact/route.ts) ---
# Supabase: tabella "leads" (name, email, service, message, created_at)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: notifica al team
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Assistente Triskiello (src/app/api/assistant/route.ts) ---
# Senza chiave l'assistente risponde con regole predefinite; con la chiave risponde un modello AI.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
